{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/api/auth/tiktok/callback",
      "destination": "https://api.solisai.video/api/auth/tiktok/callback",
      "permanent": false
    },
    {
      "source": "/api/auth/youtube/callback",
      "destination": "https://api.solisai.video/api/auth/youtube/callback",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/preview/:id", "destination": "/shareable" },
    { "source": "/preview", "destination": "/shareable" },
    { "source": "/share/:id", "destination": "/shareable" },
    { "source": "/share", "destination": "/shareable" },
    { "source": "/u/:id", "destination": "/shareable" },
    { "source": "/u", "destination": "/shareable" },
    { "source": "/shareable.html", "destination": "/shareable" },
    { "source": "/api/auth/:path*", "destination": "https://api.solisai.video/api/auth/:path*" },
    { "source": "/api/payment/:path*", "destination": "https://api.solisai.video/api/payment/:path*" },
    { "source": "/pricing", "destination": "/premium.html" },
    { "source": "/pricing.html", "destination": "/premium.html" },
    { "source": "/checkout", "destination": "/checkout.html" },
    { "source": "/checkout.html", "destination": "/checkout.html" },
    { "source": "/features", "destination": "/features.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/help", "destination": "/help.html" },
    { "source": "/terms", "destination": "/legal/terms.html" },
    { "source": "/terms.html", "destination": "/legal/terms.html" },
    { "source": "/privacy", "destination": "/legal/privacy.html" },
    { "source": "/privacy.html", "destination": "/legal/privacy.html" },
    { "source": "/refund", "destination": "/legal/refund.html" },
    { "source": "/refund.html", "destination": "/legal/refund.html" },
    { "source": "/legal", "destination": "/legal/terms.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/favicon/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|svg|ico|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
      ]
    },
    {
      "source": "/style/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" },
        { "key": "Surrogate-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*)\\.(js|mjs|cjs)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" },
        { "key": "Surrogate-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/(.*)\\.map",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/legal/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" },
        { "key": "Surrogate-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(dashboard|premium|login|welcome|checkout|features|faq|contact|help|homepage|shareable|index)",
      "headers": [
        { "key": "Cache-Control", "value": "private, no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" },
        { "key": "Surrogate-Control", "value": "no-store" }
      ]
    }
  ]
}
